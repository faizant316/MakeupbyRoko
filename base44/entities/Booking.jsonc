{
  "name": "Booking",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Full Name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "title": "Email Address"
    },
    "phone": {
      "type": "string",
      "title": "Phone Number"
    },
    "service": {
      "type": "string",
      "title": "Service Selected"
    },
    "date": {
      "type": "string",
      "title": "Appointment Date (YYYY-MM-DD)"
    },
    "time": {
      "type": "string",
      "title": "Appointment Time"
    },
    "notes": {
      "type": "string",
      "title": "Additional Notes"
    },
    "deposit_received": {
      "type": "boolean",
      "default": false,
      "title": "Zelle Deposit Received"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "completed",
        "cancelled"
      ],
      "default": "pending",
      "title": "Status"
    },
    "deposit_reminder_sent": {
      "type": "boolean",
      "default": false,
      "title": "Deposit Reminder Sent"
    },
    "appointment_reminder_sent": {
      "type": "boolean",
      "default": false,
      "title": "24hr Appointment Reminder Sent"
    },
    "feedback_request_sent": {
      "type": "boolean",
      "default": false,
      "title": "Feedback Request Sent"
    },
    "zelle_screenshot": {
      "type": "string",
      "title": "Zelle Screenshot URL"
    },
    "upload_token": {
      "type": "string",
      "title": "Secure Upload Token"
    },
    "reference_photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Reference Photos / Mood Board URLs"
    }
  },
  "required": [
    "name",
    "email",
    "service"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}