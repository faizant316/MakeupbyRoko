{
  "name": "ClassRegistration",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "title": "Full Name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "title": "Email Address"
    },
    "phone": {
      "type": "string",
      "title": "Phone Number"
    },
    "private_basic_lesson": {
      "type": "boolean",
      "default": false,
      "title": "Private Basic Makeup Lesson ($300 \u00b7 1.5 hrs)"
    },
    "virtual_lesson": {
      "type": "boolean",
      "default": false,
      "title": "Virtual Makeup Lesson ($400 \u00b7 2 hrs)"
    },
    "intermediate_lesson": {
      "type": "boolean",
      "default": false,
      "title": "Intermediate Makeup Lesson ($500 \u00b7 2.5 hrs)"
    },
    "glam_class": {
      "type": "boolean",
      "default": false,
      "title": "Glam Makeup Class ($600 \u00b7 3 hrs)"
    },
    "masterclass": {
      "type": "boolean",
      "default": false,
      "title": "Makeup Masterclass ($1500 \u00b7 4 hrs over 2 days)"
    },
    "additional_notes": {
      "type": "string",
      "title": "Additional Notes"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "enrolled",
        "declined"
      ],
      "default": "new",
      "title": "Status"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "deposit_paid",
        "paid_in_full",
        "refunded"
      ],
      "default": "pending",
      "title": "Payment Status"
    },
    "stripe_session_id": {
      "type": "string",
      "title": "Stripe Session ID"
    }
  },
  "required": [
    "full_name",
    "email",
    "phone"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}