{
  "name": "BridalInquiry",
  "type": "object",
  "properties": {
    "bride_name": {
      "type": "string",
      "title": "Bride's Full Name"
    },
    "soon_to_be_last_name": {
      "type": "string",
      "title": "Soon-to-be Last Name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "title": "Email Address"
    },
    "phone": {
      "type": "string",
      "title": "Phone Number"
    },
    "instagram_handle": {
      "type": "string",
      "title": "Instagram / TikTok Handle"
    },
    "wedding_date": {
      "type": "string",
      "title": "Wedding Date"
    },
    "event_location": {
      "type": "string",
      "title": "Event Location"
    },
    "event_start_time": {
      "type": "string",
      "title": "Event Start Time"
    },
    "photographer": {
      "type": "string",
      "title": "Photographer"
    },
    "hairstylist": {
      "type": "string",
      "title": "Hairstylist"
    },
    "venue_access_time": {
      "type": "string",
      "title": "Venue Access Time"
    },
    "num_people_glam": {
      "type": "string",
      "title": "How Many People Need Glam?"
    },
    "additional_details": {
      "type": "string",
      "title": "Additional Details"
    },
    "how_heard": {
      "type": "string",
      "title": "How Did You Hear About Me?",
      "enum": [
        "Instagram",
        "TikTok",
        "Facebook",
        "Vendor Referral",
        "Client Referral",
        "Google",
        "Other"
      ]
    },
    "preferred_date": {
      "type": "string",
      "title": "Preferred Trial/Appointment Date"
    },
    "preferred_time": {
      "type": "string",
      "title": "Preferred Time"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "booked",
        "declined"
      ],
      "default": "new",
      "title": "Status"
    }
  },
  "required": [
    "bride_name",
    "email",
    "phone",
    "wedding_date",
    "event_location",
    "event_start_time",
    "venue_access_time"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}